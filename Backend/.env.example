# Copy to .env and fill in local values. Never commit your real .env.
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/BIZPILOT_DB
PGSSL=false

# Generate a random secret of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d

# Optional Cloudinary settings (not required for auth or analytics).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
