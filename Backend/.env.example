# Copy this file to .env and set your own local values.
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection. Never commit real credentials.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/BIZPILOT_DB
PGSSL=false
DEV_USER_ID=
# Signs the sign-in tokens (at least 32 characters; required in production).
JWT_SECRET=
# Shared with the AI service (its SERVICE_JWT_SECRET must be the same value). At least 32 characters.
SERVICE_JWT_SECRET=
AI_SERVICE_URL=http://localhost:8000
# Access token lifetime (default 15m) and how long a sign-in lasts without a visit (default 30 days).
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# The refresh token is an httpOnly cookie. Secure is on in production. Use COOKIE_SAMESITE=none
# (needs https) only if the website and the API are on different sites.
COOKIE_SAMESITE=lax
TEST_DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/BIZPILOT_TEST_DB

# Set only if your team's auth middleware has not yet been mounted.
# Do not use a client-supplied business ID in production.
