# Copy to .env and fill in. Never commit .env.
PORT=8000
NODE_API_URL=http://localhost:5000

# The secret both services use to sign service tokens. It must be exactly the same value as
# SERVICE_JWT_SECRET in Backend/.env. At least 32 characters.
SERVICE_JWT_SECRET=

# A service token lives at most this many seconds (1 to 60).
SERVICE_TOKEN_TTL_SECONDS=60
NODE_TIMEOUT_SECONDS=10
LOG_LEVEL=info

# Gemini (the free tier is enough for development; use test data only).
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# Voice notes: the model that listens (it accepts audio; "gemini-3.5-transcribe" is not offered to
# every key, so check Google's models page). Larger voice notes are refused.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
MAX_AUDIO_BYTES=5242880
# TESTING ONLY: return the transcript in the draft. Never true with real data; removed before delivery.
DEBUG_RETURN_TRANSCRIPT=false

# Bill photos: a model that reads images, and its own timeout (reading takes longer than text).
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_VISION_TIMEOUT_SECONDS=40
MAX_IMAGE_BYTES=10485760
